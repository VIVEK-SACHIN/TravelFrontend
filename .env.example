# Relative URL: Vite proxies /api and /img/users → http://localhost:3000 (see vite.config.ts)
VITE_API_URL=/api/v1
# Optional: full API origin for static assets in production (e.g. http://localhost:3000)
# VITE_SERVER_URL=http://localhost:3000
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
